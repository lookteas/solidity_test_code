pragma solidity ^0.8.20;

// 这个合约的作用：在构造函数中 CREATE 用户传入的 creationCode
contract Deployer {
    constructor(bytes memory creationCode) {
        address deployed;
        assembly {
            deployed := create(0, add(creationCode, 0x20), mload(creationCode))
        }
        // 可选：确保部署成功（但不能 return）
        require(deployed != address(0), "Target CREATE failed");
    }
}

